@model IEnumerable<SubastaAutos.Application.DTOs.UsuarioDTO>

@{
    ViewData["Title"] = "Listado de usuarios";
}

<div class="table-responsive border rounded p-3 mt-4 shadow-sm">


    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Usuario
        </a>
    </div>

    <table class="table caption-top table-bordered">
        <caption data-i18n="usuario.caption">Lista de usuarios</caption>
        <thead class="table-light position-sticky top-0" style="z-index:1;">
            <tr>
                <th data-i18n="usuario.nombreCompleto">
                    @Html.DisplayNameFor(model => model.NombreCompleto)
                </th>
                <th data-i18n="usuario.rol">
                    @Html.DisplayNameFor(model => model.IdRolNavigation.Nombre)
                </th>
                <th data-i18n="usuario.estado">
                    @Html.DisplayNameFor(model => model.EstadoUsuario)
                </th>
                <th scope="col" class="text-end pe-3" style="width:260px;" data-i18n="common.actions">
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            { 
                <tr>
                    <td>
                        <span>@item.NombreCompleto</span>
                    </td>
                    <td>
                        <span>@item.IdRolNavigation.Nombre</span>
                    </td>
                    <td>
                        @if (item.EstadoUsuario)
                        {
                            <span data-i18n="common.active">Activo</span>
                        }
                        else
                        {
                            <span data-i18n="common.disabled">Deshabilitado</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group" role="group" aria-label="Acciones del autor ">
                            <a asp-action="Details" asp-route-id="@item.IdUsuario"
                               class="btn btn-outline-secondary btn-sm"
                               title="Ver detalle">
                                <i class="bi bi-eye"></i>
                                <span class="d-none d-lg-inline ms-1" data-i18n="common.detail">Detalle</span>
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.IdUsuario"
                               class="btn btn-outline-primary btn-sm"
                               title="Editar">
                                <i class="bi bi-pencil-square"></i>
                                <span class="d-none d-lg-inline ms-1">Editar</span>
                            </a>

                            <a asp-action="Delete"
                               class="btn btn-outline-danger btn-sm"
                               title="Eliminar">
                                <i class="bi bi-trash"></i>
                                <span class="d-none d-lg-inline ms-1" data-i18n="common.delete">Eliminar</span>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
