@model SubastaAutos.Application.DTOs.UsuarioDTO

@{
    ViewData["Title"] = "Editar Usuario";
}

<header class="mb-3">
    <h1 class="h3 mb-0">Editar Usuario</h1>
    <p class="text-muted mb-0">Actualización de perfil: solo nombre y correo</p>
</header>

<form asp-action="Edit" method="post" asp-route-id="@Model.IdUsuario" class="row g-3" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="IdUsuario" />
    <input type="hidden" asp-for="IdRol" />
    <input type="hidden" asp-for="FechaRegistro" />

  
    <div class="col-md-6">
        <label asp-for="NombreCompleto" class="form-label"></label>
        <input asp-for="NombreCompleto" class="form-control" />
        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>


    <div class="col-md-4">
        <label class="form-label">Rol</label>
        <input type="text" class="form-control" value="@Model.IdRolNavigation.Nombre" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Fecha de registro</label>
        <input type="text" class="form-control"
               value="@Model.FechaRegistro.ToString("dd/MM/yyyy")" readonly />
    </div>

  
    <div class="col-md-4">
        <label class="form-label">Estado</label>
        <div class="form-control d-flex align-items-center gap-2" style="background:#f8f9fa;">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="toggleEstado"
                       asp-for="EstadoUsuario" />
                <label class="form-check-label" for="toggleEstado">
                    <span id="estadoLabel">
                        @(Model.EstadoUsuario ? "Activo" : "Desactivado")
                    </span>
                </label>
            </div>
        </div>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle"></i> Guardar cambios
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleEstado').addEventListener('change', function () {
            document.getElementById('estadoLabel').textContent = this.checked ? 'Activo' : 'Desactivado';
        });
    </script>
}