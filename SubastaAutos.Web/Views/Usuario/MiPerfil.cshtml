@model SubastaAutos.Application.DTOs.UsuarioDTO
@{
    ViewData["Title"] = "Mi Perfil";
}

<header class="mb-3">
    <h1 class="h3 mb-0">
        <i class="bi bi-person-circle me-2"></i>Mi Perfil
    </h1>
    <p class="text-muted mb-0">Actualiza tu información personal</p>
</header>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white">
                <span class="fw-semibold">Datos personales</span>
            </div>
            <div class="card-body">
                <form asp-action="MiPerfil" asp-route-id="@Model.IdUsuario"
                      method="post" class="row g-3" novalidate>

                    <input type="hidden" asp-for="IdUsuario" />
                    <input type="hidden" asp-for="IdRol" />
                    <input type="hidden" asp-for="FechaRegistro" />
                    <input type="hidden" asp-for="EstadoUsuario" />

                    <div class="col-12">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>

                        <input asp-for="NombreCompleto" class="form-control" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Correo" class="form-label fw-semibold"></label>
                        <input asp-for="Correo" class="form-control" type="email" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Nueva contraseña</label>
                        <div class="input-group">
                            <input asp-for="PasswordHash"
                                   id="PasswordHash"
                                   class="form-control"
                                   type="password"
                                   placeholder="Dejar en blanco para no cambiar" />
                            <button class="btn btn-outline-secondary"
                                    type="button" id="togglePass">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Confirmar contraseña</label>
                        <div class="input-group">
                            <input type="password"
                                   id="confirmarPassword"
                                   class="form-control"
                                   placeholder="Repita la nueva contraseña" />
                            <button class="btn btn-outline-secondary"
                                    type="button" id="toggleConfirm">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div id="mensajePassword" class="form-text"></div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Rol</label>
                        <input type="text" class="form-control"
                               value="@Model.IdRolNavigation.Nombre" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Miembro desde</label>
                        <input type="text" class="form-control"
                               value="@Model.FechaRegistro.ToString("dd/MM/yyyy")" readonly />
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i>Guardar cambios
                        </button>
                        <a asp-controller="Home" asp-action="Index"
                           class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        // Validación en tiempo real
        document.getElementById("confirmarPassword").addEventListener("input", function () {
            const nueva = document.getElementById("PasswordHash").value;
            const mensaje = document.getElementById("mensajePassword");

            if (!this.value) {
                mensaje.innerHTML = '';
                return;
            }

            if (nueva === this.value) {
                mensaje.innerHTML = `<span class="text-success">
                    <i class="bi bi-check-circle me-1"></i>Las contraseñas coinciden.
                </span>`;
            } else {
                mensaje.innerHTML = `<span class="text-danger">
                    <i class="bi bi-x-circle me-1"></i>Las contraseñas no coinciden.
                </span>`;
            }
        });

        // Validación al enviar
        document.querySelector("form").addEventListener("submit", function (e) {
            const nueva = document.getElementById("PasswordHash").value;
            const confirmar = document.getElementById("confirmarPassword").value;

            // Ambos vacíos no cambia contraseña, dejar pasar
            if (!nueva && !confirmar) return;

            // Solo uno lleno
            if (nueva && !confirmar) {
                e.preventDefault();
                Swal.fire({
                    title: 'Confirma tu contraseña',
                    text: 'Debes confirmar la nueva contraseña.',
                    icon: 'warning',
                    confirmButtonText: 'Aceptar'
                });
                return;
            }

            if (!nueva && confirmar) {
                e.preventDefault();
                Swal.fire({
                    title: 'Ingresa tu contraseña',
                    text: 'Debes ingresar la nueva contraseña.',
                    icon: 'warning',
                    confirmButtonText: 'Aceptar'
                });
                return;
            }

            // No coinciden
            if (nueva !== confirmar) {
                e.preventDefault();
                Swal.fire({
                    title: 'Contraseñas no coinciden',
                    text: 'La nueva contraseña y la confirmación deben ser iguales.',
                    icon: 'error',
                    confirmButtonText: 'Intentar de nuevo'
                });
                return;
            }
       
        });
    </script>
}