@model IEnumerable<SubastaAutos.Application.DTOs.AutoDTO>

@{
    ViewData["Title"] = "Administración de Autos";
    var total = Model?.Count() ?? 0;
}

<nav class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Inicio</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Gestión de Autos</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Autos</h1>
        <p class="text-muted mb-0">Gestión administrativa de objetos subastables. Total: <strong>@total</strong>.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Auto
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-body">
        <span class="fw-semibold">Listado</span>
    </div>
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="p-4 text-center">
                <i class="bi bi-inbox display-6 mb-2"></i>
                <h2 class="h5">No hay autos registrados</h2>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Crear auto
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width:60px;">ID</th>
                            <th style="width:70px;"></th>
                            <th>Auto</th>
                            <th>Condición</th>
                            <th>Propietario</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-3" style="width:280px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.EstadoAuto == "Eliminado" ? "table-secondary" : "")">
                                <td class="ps-3">
                                    <span class="badge text-bg-light border">@item.IdAuto</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagenPrincipal))
                                    {
                                        <img src="@item.ImagenPrincipal" class="rounded"
                                             style="width:50px; height:35px; object-fit:cover;" alt="@item.NombreAuto" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image text-muted"></i>
                                    }
                                </td>
                                <td class="fw-semibold">@item.NombreAuto</td>
                                <td>@item.Condicion</td>
                                <td>@item.Propietario</td>
                                <td class="text-center">
                                    @if (item.EstadoAuto == "Activo")
                                    {
                                        <span class="badge text-bg-success">Activo</span>
                                    }
                                    else if (item.EstadoAuto == "Inactivo")
                                    {
                                        <span class="badge text-bg-warning">Inactivo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Eliminado</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (item.EstadoAuto != "Eliminado")
                                    {
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.IdAuto"
                                               class="btn btn-outline-secondary btn-sm" title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-lg-inline ms-1">Detalle</span>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.IdAuto"
                                               class="btn btn-outline-primary btn-sm" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                                <span class="d-none d-lg-inline ms-1">Editar</span>
                                            </a>

                                            @* Eliminar lógico *@
                                            <form asp-action="EliminarLogico" asp-route-id="@item.IdAuto"
                                                  method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de eliminar este auto? Esta acción no se puede deshacer.')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="d-none d-lg-inline ms-1">Eliminar</span>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin acciones</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>