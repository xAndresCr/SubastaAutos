@model IEnumerable<SubastaAutos.Application.DTOs.AutoDTO>


@{
    ViewData["Title"] = "Autos";


    var total = Model?.Count() ?? 0;
 
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Autos Subastables</h1>
     
        <p class="text-muted mb-0">
            Total registrado: <strong>@total</strong>
        </p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No hay autos registrados en este momento.
    </div>
}
else
{


    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">

        @foreach (var item in Model)
        @* VS generó este foreach. Se mantiene pero se cambia lo de adentro. *@
        {
            <div class="col">
                <article class="card h-100 shadow-sm border-0">

             
                    <div class="overflow-hidden bg-body-tertiary rounded-top"
                         style="height:220px;">
                        @if (!string.IsNullOrWhiteSpace(item.ImagenPrincipal))
                        {
                            <img class="w-100 h-100 object-fit-cover"
                                 src="@item.ImagenPrincipal"
                                 alt="Imagen de @item.NombreAuto"
                                 loading="lazy" />
                        }
                        else
                        {
                           
                            <div class="d-flex flex-column justify-content-center
                                                    align-items-center h-100 text-muted">
                                <i class="bi bi-car-front fs-1"></i>
                                <span class="small">Sin imagen</span>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                    
                        <h2 class="h6 fw-semibold mb-2 text-truncate"
                            title="@item.NombreAuto">
                            @item.NombreAuto
                        
                        </h2>

                        <div class="d-flex flex-wrap gap-1">
                    
                            <span class="badge text-bg-light border">
                                <i class="bi bi-tools me-1"></i>@item.Condicion
                            </span>

                         
                            <span class="badge text-bg-secondary">
                                @item.EstadoAuto
                            </span>
                        </div>
                    </div>

                    <div class="card-footer bg-body border-0 pb-3">
                        <div class="d-grid">
                            <a asp-action="Details" asp-route-id="@item.IdAuto"
                               class="btn btn-secondary btn-sm">
                                <i class="bi bi-eye me-1"></i>Ver detalle
                            </a>
                   
                        </div>
                    </div>

                </article>
            </div>
        }

    </div>
}

@section Scripts {
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }
    </style>
    @* Efecto sutil de elevación cuando el mouse pasa sobre una tarjeta *@
}