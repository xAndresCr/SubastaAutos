@model SubastaAutos.Application.DTOs.AutoDTO
@* VS generó esta línea correctamente. No se toca. *@

@{
    ViewData["Title"] = "Detalle del Auto";


    var tieneImagenes = Model.AutoImagen != null && Model.AutoImagen.Any();
    var tieneCategorias = Model.IdCategoria != null && Model.IdCategoria.Any();
    var tieneSubastas = Model.Subasta != null && Model.Subasta.Any();
}


<nav class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"
               class="text-decoration-none" data-i18n="common.home">Inicio</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Auto" asp-action="Index"
               class="text-decoration-none" data-i18n="auto.breadcrumbCars">Autos</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page" data-i18n="common.detail">Detalle</li>
    </ol>
</nav>


<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.NombreAuto</h1>
        <p class="text-muted mb-0" data-i18n="auto.detailSubtitle">Información completa del objeto subastable.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i><span data-i18n="auto.backBtn">Regresar</span>
    </a>

</div>


<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-body fw-semibold">
        <i class="bi bi-images me-2"></i><span data-i18n="auto.imagesTitle">Imágenes del Auto</span>
    </div>
    <div class="card-body">
        @if (!tieneImagenes)
        {
            <p class="text-muted mb-0" data-i18n="auto.noImages">Sin imágenes registradas.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var img in Model.AutoImagen)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="ratio ratio-4x3 rounded overflow-hidden border">
                            @if (img.Imagen != null && img.Imagen.Length > 0)
                            {
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(img.Imagen)"
                                     alt="Imagen del auto"
                                     class="object-fit-cover"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                    <i class="bi bi-image fs-2"></i>
                                </div>
                            }
                        </div>
                        @if (img.EsPrincipal == true)
                        {
                            <span class="badge text-bg-warning mt-1">
                                <i class="bi bi-star-fill me-1"></i><span data-i18n="auto.mainBadge">Principal</span>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>


<div class="row g-4 mb-4">

    @* ── Columna izquierda: Datos ──────────────────────────────────────────── *@
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-body fw-semibold">
                <i class="bi bi-car-front me-2"></i><span data-i18n="auto.dataTitle">Datos del Auto</span>
            </div>
            <div class="card-body">
            
                <dl class="row mb-0">


                    <dt class="col-5 text-muted" data-i18n="auto.marca">
                        @Html.DisplayNameFor(model => model.Marca)
                    </dt>
                    <dd class="col-7">@Model.Marca</dd>

                    <dt class="col-5 text-muted" data-i18n="auto.modelo">
                        @Html.DisplayNameFor(model => model.Modelo)
                    </dt>
                    <dd class="col-7">@Model.Modelo</dd>

                    <dt class="col-5 text-muted" data-i18n="auto.anio">
                        @Html.DisplayNameFor(model => model.Anio)
                    </dt>
                    <dd class="col-7">@Model.Anio</dd>

                    <dt class="col-5 text-muted" data-i18n="auto.condicion">
                        @Html.DisplayNameFor(model => model.Condicion)
                    </dt>
                    <dd class="col-7">
                        <span class="badge text-bg-light border">
                            @Model.Condicion
                        </span>
                    </dd>

                    <dt class="col-5 text-muted" data-i18n="auto.estado">
                        @Html.DisplayNameFor(model => model.EstadoAuto)
                    </dt>
                    <dd class="col-7">
                        <span class="badge text-bg-secondary">
                            @Model.EstadoAuto
                        </span>
                    </dd>

                    <dt class="col-5 text-muted" data-i18n="auto.fechaRegistro">
                        @Html.DisplayNameFor(model => model.FechaRegistro)
                    </dt>
                    <dd class="col-7">
                        @(Model.FechaRegistro.HasValue
                                                ? Model.FechaRegistro.Value.ToString("dd/MM/yyyy")
                                                : "—")
                    </dd>

                    <dt class="col-5 text-muted" data-i18n="auto.propietario">
                        @Html.DisplayNameFor(model => model.Propietario)
                    </dt>
                    <dd class="col-7">
                        <i class="bi bi-person me-1"></i>@Model.Propietario
                    </dd>

                    <dt class="col-5 text-muted" data-i18n="auto.categorias">
                        @Html.DisplayNameFor(model => model.IdCategoria)
                    </dt>
                    <dd class="col-7">
                        @if (tieneCategorias)
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var cat in Model.IdCategoria)
                                {
                                    <span class="badge text-bg-light border">
                                        <i class="bi bi-tag me-1"></i>@cat.Nombre
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted" data-i18n="auto.sinCategorias">
                                Sin categorías
                            </span>
                        }
                    </dd>

                </dl>
            </div>
        </div>
    </div>


    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-body fw-semibold">
                <i class="bi bi-card-text me-2"></i><span data-i18n="auto.descriptionTitle">Descripción</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                {
                    <p class="mb-0">@Model.Descripcion</p>
                }
                else
                {
                    <p class="text-muted mb-0" data-i18n="auto.noDescription">Sin descripción registrada.</p>
                }
            </div>
        </div>
    </div>

</div>


<div class="card shadow-sm border-0">
    <div class="card-header bg-body fw-semibold">
        <i class="bi bi-clock-history me-2"></i><span data-i18n="auto.auctionHistory">Historial de Subastas</span>
    </div>
    <div class="card-body p-0">
        @if (!tieneSubastas)
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-info-circle me-1"></i>
                <span data-i18n="auto.noAuctions">Este auto no ha participado en ninguna subasta.</span>
            </div>
        }
        else
        {
            <div class="table-responsive" id="AutoSubastaDetalle">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" data-i18n="autoSubastaDetalle.id">
                                @Html.DisplayNameFor(m => m.Subasta[0].IdSubasta)
                            </th>
                            <th data-i18n="autoSubastaDetalle.fechaInicio">
                                @Html.DisplayNameFor(m => m.Subasta[0].FechaInicio)
                            </th>
                            <th data-i18n="autoSubastaDetalle.fechaCierre">
                                @Html.DisplayNameFor(m => m.Subasta[0].FechaCierre)
                            </th>
                            <th data-i18n="autoSubastaDetalle.estado">
                                @Html.DisplayNameFor(m => m.Subasta[0].EstadoSubasta)
                            </th>
                            <th class="pe-3 text-end" data-i18n="autoSubastaDetalle.acciones">
                                Acciones
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model.Subasta)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge text-bg-light border">
                                        #@sub.IdSubasta
                                    </span>
                                </td>

                                <td class="text-muted">
                                    @sub.FechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-muted">
                                    @sub.FechaCierre.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="badge text-bg-secondary">
                                        @sub.EstadoSubasta
                                    </span>
                                </td>

                                <td class="pe-3 text-end">
                                    <a asp-controller="Subasta"
                                       asp-action="Details"
                                       asp-route-id="@sub.IdSubasta"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye me-1"></i>
                                        <span data-i18n="auto.viewAuction">Ver subasta</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
