@model SubastaAutos.Application.DTOs.AutoDTO

@{
    ViewData["Title"] = "Crear Auto";
}

<header class="mb-3">
    <h1 class="h3 mb-0">Crear Auto</h1>
    <p class="text-muted mb-0">Registro de un nuevo objeto subastable</p>
</header>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>


    <div class="col-md-6">
        <label class="form-label">Vendedor</label>
        <input type="text" class="form-control" value="@ViewBag.VendedorNombre" readonly />
        <input type="hidden" asp-for="IdVendedor" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Estado</label>
        <input type="text" class="form-control" value="Activo" readonly />
        <input type="hidden" asp-for="IdEstadoAuto" />
    </div>

    <div class="col-md-4">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" />
        <span asp-validation-for="Marca" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Modelo" class="form-label"></label>
        <input asp-for="Modelo" class="form-control" />
        <span asp-validation-for="Modelo" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Anio" class="form-label"></label>
        <input asp-for="Anio" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Anio" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Vin" class="form-label"></label>
        <input asp-for="Vin" class="form-control" autocomplete="off" />
        <span asp-validation-for="Vin" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdCondicionAuto" class="form-label">Condición</label>
        <select asp-for="IdCondicionAuto" class="form-select" asp-items="ViewBag.ListCondicion">
            <option value="">-- Seleccione condición --</option>
        </select>
        <span asp-validation-for="IdCondicionAuto" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"
                  placeholder="Mínimo 20 caracteres"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label class="form-label">Categorías</label>
        <select id="selectedCategorias" name="selectedCategorias"
                class="form-select" asp-items="ViewBag.ListCategorias" multiple>
        </select>
        <div class="form-text">Puede seleccionar múltiples categorías (mínimo 1).</div>
        @if (ViewData.ModelState.ContainsKey("selectedCategorias"))
        {
            <span class="text-danger">@ViewData.ModelState["selectedCategorias"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        }
    </div>

    <div class="col-12">
        <label class="form-label" for="imageFiles">Imágenes</label>
        <input type="file" id="imageFiles" name="imageFiles"
               class="form-control" accept="image/*" multiple required />
        <div class="form-text">Puede seleccionar múltiples imágenes (mínimo 1). La primera será la principal.</div>
        @if (ViewData.ModelState.ContainsKey("imageFiles"))
        {
            <span class="text-danger">@ViewData.ModelState["imageFiles"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        }

        <div id="previewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle"></i> Guardar
        </button>
        <a asp-action="IndexAdmin" class="btn btn-outline-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('imageFiles');
        const container = document.getElementById('previewContainer');
        input?.addEventListener('change', () => {
            container.innerHTML = '';
            if (!input.files) return;
            Array.from(input.files).forEach((file, i) => {
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.className = 'img-thumbnail';
                img.style.maxHeight = '120px';
                img.alt = `Imagen ${i + 1}`;
                container.appendChild(img);
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            if ($.fn.multiselect) {
                $('#selectedCategorias').multiselect({
                    buttonClass: 'form-select',
                    templates: {
                        button: '<button type="button" class="multiselect dropdown-toggle" data-bs-toggle="dropdown"><span class="multiselect-selected-text"></span></button>',
                    },
                    includeSelectAllOption: true,
                    selectAllText: 'Seleccionar todas',
                    allSelectedText: 'Todas las categorías',
                    nonSelectedText: '-- Seleccione categorías --',
                    nSelectedText: ' categorías seleccionadas',
                });
            }
        });
    </script>
}