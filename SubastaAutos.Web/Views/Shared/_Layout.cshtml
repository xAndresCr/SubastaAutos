<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Subastas</title>
    <script type="importmap"></script>
    <!--Preconección (mejorar carga CDN)-->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!--Bootstrap 5.3.8-->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <!--Bootstrap Icons-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!--SweetAlert 2-->
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <!--jQuery UI CSS-->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <!--Bootstrap Multiselect CSS (depende de Bootstrap + jQuery)-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/css/bootstrap-multiselect.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!--Estilos propios-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SubastaAutos.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        @await Html.PartialAsync("_Menu")
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="mt-auto border-top">
        <div class="container py-3 small text-muted d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center">
            <div>
                &copy; @DateTime.Now.Year - SubaCar
            </div>
            <div>
                <a class="link-secondary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">
                    <span data-i18n="common.privacy">Privacidad</span>
                </a>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <!-- 1. jQuery (solo una vez, desde local) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- 2. jQuery UI (depende de jQuery) -->
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js" crossorigin="anonymous"></script>

    <!-- 3. Bootstrap JS (depende de jQuery) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 4. Bootstrap Multiselect (depende de jQuery + Bootstrap) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/js/bootstrap-multiselect.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <!-- 5. SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- 6. I18N -->
    <script src="https://unpkg.com/i18next@23.0.0/i18next.min.js"></script>
    <script src="https://unpkg.com/i18next-http-backend@2.0.0/i18nextHttpBackend.min.js"></script>
    <script src="https://unpkg.com/i18next-browser-languagedetector@7.2.1/i18nextBrowserLanguageDetector.min.js"></script>
    <script src="~/js/i18n.js"></script>

    <!-- 7. Scripts propios -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- 8. Notificaciones SweetAlert -->
    <script>
        (function () {
            var tempRaw = '@Html.Raw(TempData["Notificacion"] ?? "")';
            if (tempRaw) {
                try {
                    var c = JSON.parse(tempRaw);
                    Swal.fire({ title: c.title, html: c.text, icon: c.icon });
                } catch (e) { }
            }
            var vbRaw = '@Html.Raw(ViewBag.Notificacion ?? "")';
            if (vbRaw) {
                try {
                    var c = JSON.parse(vbRaw);
                    Swal.fire({ title: c.title, html: c.text, icon: c.icon });
                } catch (e) { }
            }
        })();
    </script>

    <!-- 9. Scripts de secciones específicas -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>