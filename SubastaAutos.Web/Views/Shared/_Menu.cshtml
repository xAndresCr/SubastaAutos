@{
    var rolUsuario = Context.Session.GetInt32("UsuarioRol");
    var nombreUsuario = Context.Session.GetString("UsuarioNombre") ?? "Invitado";
}

<nav class="navbar navbar-expand-lg bg-secondary" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
            <i class="bi bi-speedometer"></i><span data-i18n="nav.brand">SubaCar</span>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                @* ── Home ── *@
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-fill me-1"></i>Inicio
                    </a>
                </li>

                @* ── Subastas ── *@
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-hammer me-1"></i>Subastas
                    </a>
                    <ul class="dropdown-menu">
                        @* Todos ven las activas *@
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Subasta" asp-action="Index">
                                <i class="bi bi-lightning me-1"></i>Activas
                            </a>
                        </li>

                        @* Admin ve todas las subastas *@
                        @if (rolUsuario == 1)
                        {
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Subasta" asp-action="IndexAdmin">
                                    <i class="bi bi-list-ul me-1"></i>Todas las Subastas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Subasta" asp-action="Finalizadas">
                                    <i class="bi bi-archive me-1"></i>Finalizadas
                                </a>
                            </li>
                        }

                        @* Solo comprador ve sus subastas ganadas *@
                        @if (rolUsuario == 2)
                        {
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Subasta" asp-action="MisSubastas">
                                    <i class="bi bi-trophy me-1"></i>Mis Subastas
                                </a>
                            </li>
                        }

                        @* Solo vendedor ve sus subastas *@
                        @if (rolUsuario == 3)
                        {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Subasta" asp-action="IndexAdmin">
                                    <i class="bi bi-list-ul me-1"></i>Mis Subastas
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                @* ── Mantenimientos (admin y vendedor) ── *@
                @if (rolUsuario == 1 || rolUsuario == 3)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear-fill me-1"></i>Mantenimientos
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Auto" asp-action="IndexAdmin">
                                    <i class="bi bi-car-front me-1"></i>Autos
                                </a>
                            </li>
                            @* Admin ve mantenimiento de subastas *@
                            @if (rolUsuario == 1)
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Subasta" asp-action="IndexAdmin">
                                        <i class="bi bi-hammer me-1"></i>Subastas
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Usuario" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Usuarios
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @* ── Reportes (solo admin) ── *@
                @if (rolUsuario == 1)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-graph-up me-1"></i>Reportes
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Reporte" asp-action="SubastasPorCategoria">
                                    <i class="bi bi-bar-chart-fill me-1"></i>Subastas por categoría
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Reporte" asp-action="ActividadPorPeriodo">
                                    <i class="bi bi-activity me-1"></i>Actividad por periodo
                                </a>
                            </li>
                        </ul>
                    </li>
                }

            </ul>

            <ul class="navbar-nav ms-auto align-items-center">

                @* ── Switch de idioma ── *@
                <li class="nav-item d-flex align-items-center me-3">
                    <span class="text-light small fw-semibold me-2">ES</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="languageSwitch"
                               style="cursor:pointer; width:2.5em; height:1.3em;"
                               onchange="changeLanguage(this.checked ? 'en' : 'es')">
                        <label class="form-check-label text-light small fw-semibold"
                               for="languageSwitch"
                               id="languageSwitchLabel"
                               style="cursor:pointer;">
                            EN
                        </label>
                    </div>
                </li>

                @* ── Usuario / Logout ── *@
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img class="rounded-circle me-2"
                             src="~/images/profile.png"
                             alt="Perfil"
                             width="32" height="32" />
                        <span class="d-none d-sm-inline">@nombreUsuario</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-controller="Login" asp-action="LogOut" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>

            </ul>
        </div>
    </div>
</nav>