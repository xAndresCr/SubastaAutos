@model SubastaAutos.Application.DTOs.SubastaDTO

@{
    ViewData["Title"] = "Crear Subasta";
}

<header class="mb-3">
    <h1 class="h3 mb-0">Crear Subasta</h1>
    <p class="text-muted mb-0">La subasta se creará como borrador hasta que decida publicarla</p>
</header>

<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="IdVendedor" />
    <input type="hidden" asp-for="IdEstadoSubasta" />

    @*Vendedor (no editable)  *@
    <div class="col-md-6">
        <label class="form-label">Vendedor</label>
        <input type="text" class="form-control" value="@ViewBag.VendedorNombre" readonly />
    </div>

    @*  Estado (no editable)  *@
    <div class="col-md-6">
        <label class="form-label">Estado</label>
        <input type="text" class="form-control" value="Borrador" readonly />
    </div>

    @* Auto *@
    <div class="col-12">
        <label asp-for="IdAuto" class="form-label">Auto a subastar</label>
        <select asp-for="IdAuto" class="form-select" asp-items="ViewBag.ListAutos">
            <option value="">-- Seleccione un auto --</option>
        </select>
        <span asp-validation-for="IdAuto" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FechaInicio" class="form-label"></label>
        <input asp-for="FechaInicio" class="form-control" type="datetime-local" step="1" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FechaCierre" class="form-label"></label>
        <input asp-for="FechaCierre" class="form-control" type="datetime-local" step="1" />
        <span asp-validation-for="FechaCierre" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PrecioBase" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="PrecioBase" class="form-control"
                   inputmode="numeric" onfocus="this.select()" />
        </div>
        <span asp-validation-for="PrecioBase" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IncrementoMinimo" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="IncrementoMinimo" class="form-control"
                   inputmode="numeric" onfocus="this.select()" />
        </div>
        <span asp-validation-for="IncrementoMinimo" class="text-danger"></span>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle"></i> Guardar como borrador
        </button>
        <a asp-action="IndexAdmin" class="btn btn-outline-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}