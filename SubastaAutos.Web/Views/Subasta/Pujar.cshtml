@model SubastaAutos.Application.DTOs.SubastaDTO
@{
    ViewData["Title"] = $"Subasta #{Model.IdSubasta}";
    var esActiva = Model.EstadoSubasta == "Activa";
    var pujaFueSuperada = (bool)(ViewBag.PujaFueSuperada ?? false);
    var culture = new System.Globalization.CultureInfo("es-CR");
    var tieneImagenes = Model.AutoImagenes != null && Model.AutoImagenes.Any();

    var esGanador = (bool)(ViewBag.EsGanador ?? false);
    var pagoRegistrado = (bool)(ViewBag.PagoRegistrado ?? false);
    var pagoConfirmado = (bool)(ViewBag.PagoConfirmado ?? false);
    var idPago = (int)(ViewBag.IdPago ?? 0);
    var estadoPagoNombre = (string)(ViewBag.EstadoPagoNombre ?? "Sin registrar");
    var esFinalizada = Model.EstadoSubasta == "Finalizada";
    var esVendedor = (bool)(ViewBag.EsVendedor ?? false);
    var montoSiguientePuja = (decimal)(ViewBag.MontoSiguientePuja ?? 0m);
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>
        <span data-i18n="common.backToList">Volver al listado</span>
    </a>
</div>

@* ── Notificación puja superada ── *@
@if (pujaFueSuperada)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>¡Su puja ha sido superada!</strong> Otro usuario realizó una oferta mayor.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ══════════════════════════════════════════════════════════════
   SECCIÓN 1: GALERÍA DE IMÁGENES (ancho completo)
   ══════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-body fw-semibold">
        <i class="bi bi-images me-2"></i>Imágenes del Vehículo
    </div>
    <div class="card-body">
        @if (!tieneImagenes)
        {
            <div class="d-flex flex-column justify-content-center align-items-center text-muted py-5">
                <i class="bi bi-car-front" style="font-size:4rem;"></i>
                <span>Sin imágenes disponibles</span>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var img in Model.AutoImagenes)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="ratio ratio-4x3 rounded overflow-hidden border">
                            @if (img.Imagen != null && img.Imagen.Length > 0)
                            {
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(img.Imagen)"
                                     alt="Imagen del vehículo"
                                     class="object-fit-cover"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                    <i class="bi bi-image fs-2"></i>
                                </div>
                            }
                        </div>
                        @if (img.EsPrincipal)
                        {
                            <span class="badge text-bg-warning mt-1">
                                <i class="bi bi-star-fill me-1"></i>Principal
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ══════════════════════════════════════════════════════════════
   SECCIÓN 2: INFO DE SUBASTA (izq) + PUJAR/PAGO (der)
   ══════════════════════════════════════════════════════════════ *@
<div class="row g-4">

    @* ── Columna izquierda: Información de la subasta ── *@
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white">
                <h1 class="h5 mb-0">
                    <i class="bi bi-hammer me-2"></i>@Model.NombreAuto
                </h1>
            </div>
            <div class="card-body">

                @* Descripción del vehículo *@
                @if (!string.IsNullOrWhiteSpace(Model.DescripcionAuto))
                {
                    <p class="mb-3 text-muted">@Model.DescripcionAuto</p>
                    <hr />
                }

                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Vendedor</dt>
                    <dd class="col-7">@Model.Vendedor</dd>

                    <dt class="col-5 text-muted">Fecha de Inicio</dt>
                    <dd class="col-7">
                        <i class="bi bi-calendar-event me-1"></i>
                        @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-5 text-muted">Fecha de Cierre</dt>
                    <dd class="col-7">
                        <i class="bi bi-calendar-x me-1"></i>
                        @Model.FechaCierre.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-5 text-muted">Precio Base</dt>
                    <dd class="col-7">
                        <span class="fw-semibold">
                            @Model.PrecioBase.ToString("C", culture)
                        </span>
                    </dd>

                    <dt class="col-5 text-muted">Incremento Mínimo</dt>
                    <dd class="col-7">
                        @Model.IncrementoMinimo.ToString("C", culture)
                    </dd>

                    <dt class="col-5 text-muted">Estado</dt>
                    <dd class="col-7">
                        @if (Model.EstadoSubasta == "Activa")
                        {
                            <span class="badge text-bg-success">@Model.EstadoSubasta</span>
                        }
                        else if (Model.EstadoSubasta == "Finalizada")
                        {
                            <span class="badge text-bg-secondary">@Model.EstadoSubasta</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">@Model.EstadoSubasta</span>
                        }
                    </dd>

                    @{
                        var pujaLider = Model.Pujas.OrderByDescending(p => p.Monto).FirstOrDefault();
                    }

                    <dt class="col-5 text-muted">Puja Más Alta</dt>
                    <dd class="col-7">
                        <span class="fw-bold text-success fs-5" id="montoLider">
                            @if (pujaLider != null)
                            {
                                @pujaLider.Monto.ToString("C", culture)
                            }
                            else
                            {
                                <span class="text-muted">Sin pujas</span>
                            }
                        </span>
                    </dd>

                    <dt class="col-5 text-muted">Usuario Líder</dt>
                    <dd class="col-7">
                        <span id="nombreLider">
                            @(pujaLider?.NombrePostor ?? "Sin pujas")
                        </span>
                    </dd>
                </dl>

                @* ── Contador de tiempo restante ── *@
                <hr class="my-3" />
                <div class="text-center p-3 bg-light rounded">
                    <span class="text-muted small d-block">Tiempo Restante</span>
                    <span id="contador" class="fs-2 fw-bold text-danger">--:--:--</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Columna derecha: Formulario de puja + Pago ── *@
    <div class="col-md-5">

        @* ── Card de pujar ── *@
        @if (esActiva && !esVendedor)
        {
            <div class="card shadow-sm border-0" id="cardPujar">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-cash-coin me-2"></i>Realizar Puja
                    </h6>
                </div>
                <div class="card-body text-center">
                    <p class="text-muted mb-1">Monto de la siguiente puja:</p>
                    <span class="fs-3 fw-bold text-success d-block mb-3" id="lblMontoSiguiente">
                        @montoSiguientePuja.ToString("C", culture)
                    </span>
                    <button class="btn btn-success btn-lg w-100" id="btnPujar">
                        <i class="bi bi-hammer me-1"></i> Pujar
                    </button>
                    <div id="mensajePuja" class="mt-2"></div>
                </div>
            </div>
        }
        else if (esActiva && esVendedor)
        {
            <div class="alert alert-info" id="cardPujar">
                <i class="bi bi-person-badge me-2"></i>
                Eres el vendedor de esta subasta. No podés realizar pujas.
            </div>
        }
        else
        {
            <div class="alert alert-secondary" id="cardPujar">
                <i class="bi bi-lock me-2"></i>
                Esta subasta no está activa. No se pueden realizar pujas.
            </div>
        }

        @* ── Botón de pago (solo ganador + subasta finalizada) ── *@
        <div id="contenedorBtnPago"
             style="@((esFinalizada && esGanador) ? "" : "display:none;")">
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-body text-center">
                    <p class="mb-2 text-success fw-bold">
                        <i class="bi bi-trophy-fill me-1"></i>¡Felicidades, ganaste esta subasta!
                    </p>
                    <button class="btn btn-primary" id="btnAbrirPago"
                            data-bs-toggle="modal" data-bs-target="#modalPago">
                        <i class="bi bi-credit-card me-1"></i> Ir al Pago
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@* ══════════════════════════════════════════════════════════════
   SECCIÓN 3: HISTORIAL DE PUJAS (ancho completo)
   ══════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-dark text-white">
        <h6 class="mb-0">
            <i class="bi bi-clock-history me-2"></i>Historial de Pujas
        </h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Monto</th>
                    <th>Fecha y Hora</th>
                </tr>
            </thead>
            <tbody id="historialPujas">
                @if (Model.Pujas.Any())
                {
                    @foreach (var puja in Model.Pujas)
                    {
                        <tr>
                            <td>@puja.NombrePostor</td>
                            <td>@puja.Monto.ToString("C", culture)</td>
                            <td>@puja.FechaHora?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="sinPujas">
                        <td colspan="3" class="text-center text-muted py-3">
                            No hay pujas registradas aún.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Modal de Pago ── *@
<div class="modal fade" id="modalPago" tabindex="-1" aria-labelledby="modalPagoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalPagoLabel">
                    <i class="bi bi-credit-card me-2"></i>Pago de Subasta
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Subasta</dt>
                    <dd class="col-7">#@Model.IdSubasta — @Model.NombreAuto</dd>

                    <dt class="col-5 text-muted">Ganador</dt>
                    <dd class="col-7 fw-semibold" id="pagoGanador">
                        @{
                            var ganadorPuja = Model.Pujas.OrderByDescending(p => p.Monto).FirstOrDefault();
                        }
                        <i class="bi bi-trophy-fill text-warning me-1"></i>
                        @(ganadorPuja?.NombrePostor ?? "—")
                    </dd>

                    <dt class="col-5 text-muted">Monto Final</dt>
                    <dd class="col-7">
                        <span class="fw-bold text-success" id="pagoMonto">—</span>
                    </dd>

                    <dt class="col-5 text-muted">Estado del Pago</dt>
                    <dd class="col-7">
                        <span id="estadoPagoBadge"
                              class="badge @(pagoConfirmado ? "text-bg-success" :
                                                               pagoRegistrado ? "text-bg-warning" : "text-bg-secondary")">
                            @estadoPagoNombre
                        </span>
                    </dd>
                </dl>
                <div id="pagoMensaje" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button" class="btn btn-primary" id="btnRegistrarPago"
                        style="@(pagoRegistrado ? "display:none;" : "")">
                    <i class="bi bi-receipt me-1"></i> Registrar Pago
                </button>

                <button type="button" class="btn btn-success" id="btnConfirmarPago"
                        style="@(pagoRegistrado && !pagoConfirmado ? "" : "display:none;")">
                    <i class="bi bi-check-circle me-1"></i> Confirmar Pago
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const idSubasta = @Model.IdSubasta;
        const fechaCierre = new Date("@Model.FechaCierre.ToString("yyyy-MM-ddTHH:mm:ss")");
        const esActiva = @esActiva.ToString().ToLower();
        const esVendedor = @esVendedor.ToString().ToLower();
        const usuarioActualId = @ViewBag.UsuarioActualId;
        let montoSiguiente = @montoSiguientePuja.ToString(System.Globalization.CultureInfo.InvariantCulture);
        let montoLiderActual = @(pujaLider != null ? pujaLider.Monto.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0");

        // ═══════ CONTADOR ═══════
        function actualizarContador() {
            const ahora = new Date();
            const diferencia = fechaCierre - ahora;

            if (diferencia <= 0) {
                document.getElementById("contador").textContent = "00:00:00";
                if (esActiva) cerrarSubasta();
                return;
            }

            const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
            const horas = Math.floor((diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
            const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

            document.getElementById("contador").textContent = dias > 0
                ? `${dias}d ${String(horas).padStart(2, '0')}:${String(minutos).padStart(2, '0')}:${String(segundos).padStart(2, '0')}`
                : `${String(horas).padStart(2, '0')}:${String(minutos).padStart(2, '0')}:${String(segundos).padStart(2, '0')}`;
        }

        const intervaloContador = setInterval(actualizarContador, 1000);
        actualizarContador();

        // ═══════ CERRAR SUBASTA ═══════
        let yaSeCerro = false;
        async function cerrarSubasta() {
            if (yaSeCerro) return;
            yaSeCerro = true;
            clearInterval(intervaloContador);

            const response = await fetch(`/Subasta/CerrarSubasta?id=${idSubasta}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const data = await response.json();
            if (!data.success) {
                yaSeCerro = false;
            }
        }

        // ═══════ FUNCIONES AUXILIARES ═══════
        function formatearMonto(valor) {
            return `₡${Number(valor).toLocaleString('es-CR', { minimumFractionDigits: 2 })}`;
        }

        function actualizarMontoSiguiente(nuevoMonto) {
            montoSiguiente = nuevoMonto;
            const lbl = document.getElementById("lblMontoSiguiente");
            if (lbl) lbl.textContent = formatearMonto(nuevoMonto);
        }

        // ═══════ SIGNALR ═══════
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/subastaHub")
            .withAutomaticReconnect()
            .build();

        // ── Nueva puja en tiempo real ──
                connection.on("NuevaPuja", function (data) {
            // Actualizar líder para TODOS
            document.getElementById("montoLider").innerHTML = formatearMonto(data.montoLider);
            document.getElementById("nombreLider").textContent = data.nombreLider;
            
            montoLiderActual = data.montoLider;
            actualizarMontoModal();

            if (data.montoSiguiente) {
                actualizarMontoSiguiente(data.montoSiguiente);
            }

            // Si fui YO quien pujó, no agregar al historial (ya se hizo en el callback del fetch)
            if (data.idUsuarioQuePujo === usuarioActualId) return;

            // Quitar "Sin Pujas"
            const sinPujas = document.getElementById("sinPujas");
            if (sinPujas) sinPujas.remove();

            // Agregar al historial solo para los DEMÁS
            const historial = document.getElementById("historialPujas");
            historial.insertAdjacentHTML("afterbegin", `
                <tr>
                    <td>${data.nombrePostor}</td>
                    <td>${formatearMonto(data.monto)}</td>
                    <td>${data.fechaHora}</td>
                </tr>`);

            // Notificación "puja superada" solo si no fui yo
            if (data.idUsuarioLider !== usuarioActualId) {
                Swal.fire({
                    title: '¡Puja superada!',
                    text: 'Su puja ha sido superada por otro usuario.',
                    icon: 'warning',
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#ffc107'
                });
            }
        });

        // ── Subasta cerrada ──
        connection.on("SubastaCerrada", function (data) {
            clearInterval(intervaloContador);
            document.getElementById("contador").textContent = "00:00:00";

            const cardPujar = document.getElementById("cardPujar");
            if (cardPujar) {
                if (data.huboPujas) {
                    cardPujar.innerHTML = `
                        <div class="card-body">
                            <div class="alert alert-danger mb-0">
                                <i class="bi bi-lock-fill me-2"></i>
                                <strong>Subasta finalizada.</strong><br/>
                                Ganador: <strong>${data.ganador}</strong><br/>
                                Monto final: <strong>${formatearMonto(data.montoFinal)}</strong>
                            </div>
                        </div>`;
                } else {
                    cardPujar.innerHTML = `
                        <div class="card-body">
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-slash-circle me-2"></i>
                                <strong>Subasta finalizada sin ofertas.</strong><br/>
                                No se registraron pujas para esta subasta.
                            </div>
                        </div>`;
                }
            }
                    montoLiderActual = data.montoFinal;
                            const elGanador = document.getElementById("pagoGanador");
        if (elGanador) elGanador.innerHTML = `<i class="bi bi-trophy-fill text-warning me-1"></i>${data.ganador}`;
        actualizarMontoModal();
            // Mostrar botón de pago SOLO al ganador
            if (data.huboPujas && data.idUsuarioGanador === usuarioActualId) {
                const contenedor = document.getElementById("contenedorBtnPago");
                if (contenedor) contenedor.style.display = "";
            }
        });

        // ── Iniciar conexión ──
        connection.start()
            .then(() => {
                connection.invoke("UnirseASubasta", idSubasta.toString());
            })
            .catch(err => console.error("SignalR error:", err));

        // ═══════ BOTÓN PUJAR ═══════
        const btnPujar = document.getElementById("btnPujar");
        if (btnPujar && esActiva && !esVendedor) {
            btnPujar.addEventListener("click", async function () {
                this.disabled = true;
                const mensajeDiv = document.getElementById("mensajePuja");

                const response = await fetch("/Subasta/Pujar", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ idSubasta: idSubasta, monto: montoSiguiente })
                });

                const data = await response.json();

                if (data.success) {
                    mensajeDiv.innerHTML = `<div class="alert alert-success py-2">${data.mensaje}</div>`;

                    Swal.fire({
                        title: '¡Puja registrada!',
                        text: data.mensaje,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: true
                    });

                    // Actualizar líder localmente
                    document.getElementById("montoLider").innerHTML = formatearMonto(data.montoLider);
                    document.getElementById("nombreLider").textContent = data.nombreLider;
                    montoLiderActual = data.montoLider;
                    actualizarMontoModal();
                    // Actualizar monto siguiente
                    if (data.montoSiguiente) {
                        actualizarMontoSiguiente(data.montoSiguiente);
                    }

                    // Actualizar historial
                    const sinPujas = document.getElementById("sinPujas");
                    if (sinPujas) sinPujas.remove();

                    const historial = document.getElementById("historialPujas");
                    historial.insertAdjacentHTML("afterbegin", `
                        <tr>
                            <td>${data.nombrePostor}</td>
                            <td>${formatearMonto(data.monto)}</td>
                            <td>${data.fechaHora}</td>
                        </tr>`);
                } else {
                    mensajeDiv.innerHTML = `<div class="alert alert-danger py-2">${data.mensaje}</div>`;

                    Swal.fire({
                        title: 'Error',
                        text: data.mensaje,
                        icon: 'error',
                        confirmButtonText: 'Aceptar'
                    });
                }

                this.disabled = false;
            });
        }

        // ═══════ PAGO ═══════
        let pagoIdActual = @idPago;

        document.getElementById("btnRegistrarPago")?.addEventListener("click", async function () {
            this.disabled = true;
            const mensajeDiv = document.getElementById("pagoMensaje");

            const response = await fetch("/Pago/Registrar", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(idSubasta)
            });

            const data = await response.json();

            if (data.success) {
                pagoIdActual = data.idPago;
                mensajeDiv.innerHTML = `<div class="alert alert-success py-2">${data.mensaje}</div>`;

                const badge = document.getElementById("estadoPagoBadge");
                badge.className = "badge text-bg-warning";
                badge.textContent = data.estado;

                this.style.display = "none";
                document.getElementById("btnConfirmarPago").style.display = "";

                Swal.fire({ title: 'Pago registrado', text: data.mensaje, icon: 'success', timer: 2000, showConfirmButton: true });
            } else {
                mensajeDiv.innerHTML = `<div class="alert alert-danger py-2">${data.mensaje}</div>`;
                this.disabled = false;
            }
        });

        document.getElementById("btnConfirmarPago")?.addEventListener("click", async function () {
            this.disabled = true;
            const mensajeDiv = document.getElementById("pagoMensaje");

            const response = await fetch("/Pago/Confirmar", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(pagoIdActual)
            });

            const data = await response.json();

            if (data.success) {
                mensajeDiv.innerHTML = `<div class="alert alert-success py-2">${data.mensaje}</div>`;

                const badge = document.getElementById("estadoPagoBadge");
                badge.className = "badge text-bg-success";
                badge.textContent = data.estado;

                this.style.display = "none";

                Swal.fire({ title: '¡Pago confirmado!', text: data.mensaje, icon: 'success', confirmButtonText: 'Aceptar' });
            } else {
                mensajeDiv.innerHTML = `<div class="alert alert-danger py-2">${data.mensaje}</div>`;
                this.disabled = false;
            }
        });

                function actualizarMontoModal() {
            const el = document.getElementById("pagoMonto");
            if (el) el.textContent = formatearMonto(montoLiderActual);
        }
        actualizarMontoModal();
    </script>
}