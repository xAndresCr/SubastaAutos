@model SubastaAutos.Application.DTOs.SubastaDTO

@{
    ViewData["Title"] = "Editar Subasta";
}

<header class="mb-3">
    <h1 class="h3 mb-0">Editar Subasta</h1>
    <p class="text-muted mb-0">Modificar datos de la subasta #@Model.IdSubasta</p>
</header>

<form asp-action="Edit" method="post" asp-route-id="@Model.IdSubasta" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="IdSubasta" />
    <input type="hidden" asp-for="IdAuto" />
    <input type="hidden" asp-for="IdVendedor" />
    <input type="hidden" asp-for="IdEstadoSubasta" />
    <input type="hidden" asp-for="FechaCreacion" />


    <div class="col-md-4">
        <label class="form-label">Vendedor</label>
        <input type="text" class="form-control" value="@Model.Vendedor" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Auto</label>
        <input type="text" class="form-control" value="@Model.NombreAuto" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Estado</label>
        <input type="text" class="form-control" value="@Model.EstadoSubasta" readonly />
    </div>


    <div class="col-md-6">
        <label asp-for="FechaInicio" class="form-label"></label>
        <input asp-for="FechaInicio" class="form-control" type="datetime-local" step="1" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FechaCierre" class="form-label"></label>
        <input asp-for="FechaCierre" class="form-control" type="datetime-local" step="1" />
        <span asp-validation-for="FechaCierre" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PrecioBase" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="PrecioBase" class="form-control"
                   inputmode="numeric" onfocus="this.select()" />
        </div>
        <span asp-validation-for="PrecioBase" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IncrementoMinimo" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="IncrementoMinimo" class="form-control"
                   inputmode="numeric" onfocus="this.select()" />
        </div>
        <span asp-validation-for="IncrementoMinimo" class="text-danger"></span>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle"></i> Guardar cambios
        </button>
        <a asp-action="IndexAdmin" class="btn btn-outline-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}